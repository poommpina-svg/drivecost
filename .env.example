NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Supabase public values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never put this value in index.html, admin.js, or browser code.
SUPABASE_SECRET_KEY=sb_secret_...

# Bootstrap administrators. Comma-separated.
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# Generate a random value of at least 32 characters.
IP_HASH_SALT=replace-with-a-long-random-value

ADMIN_DASHBOARD_ENABLED=true

# Optional tuning
REQUEST_TIMEOUT_MS=10000
MAX_JSON_BODY_BYTES=65536
ADMIN_CACHE_MS=30000
FUEL_CACHE_TTL_MS=900000
FUEL_STALE_TTL_MS=86400000
